# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.eggs/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ML / training artifacts
runs/
weights/
*.pt
*.engine
*.onnx
*.trt
datasets/
data/wildfire_signals.jsonl
data/evidence/
*.tar.zst

# fire_detection's runs/ + checkpoints/ are gitignored (covered by patterns
# above), but we explicitly preserve their README.md placeholders so the
# directory layout documented in ml/fire_detection/RELEASE.md exists in fresh
# clones.
!ml/fire_detection/runs/
!ml/fire_detection/runs/README.md
!ml/fire_detection/checkpoints/
!ml/fire_detection/checkpoints/README.md
ml/fire_detection/runs/*
ml/fire_detection/checkpoints/*
!ml/fire_detection/runs/README.md
!ml/fire_detection/checkpoints/README.md

# Flight logs
*.bin
*.tlog
*.BIN
*.TLOG

# CAD scratch
hardware/cad/*.f3z
hardware/cad/*.step.bak

# Secrets / env
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Local zones (real ones, not the example)
missions/zones/*.geojson
!missions/zones.example.geojson
# Canonical AOR zone definition is tracked (the corridor + exclusions); operator-specific sub-zones remain local-only.
!missions/zones/gunnison_crested_butte_corridor.geojson
